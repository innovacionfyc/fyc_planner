# Credenciales / configs locales
/config/db.php
/config/mail.php
/config/app.local.php
.env
.env.*.local

# Dependencias (por si en el futuro usas Composer o Node)
/vendor/
/node_modules/

# Archivos subidos por usuarios
/public/uploads/
# Se ignora el contenido de storage/, pero se versiona el esqueleto de
# storage/attachments/ (.gitkeep y .htaccess) para que exista tras el deploy.
/storage/*
!/storage/attachments/
/storage/attachments/*
!/storage/attachments/.gitkeep
!/storage/attachments/.htaccess

# Dumps de BD (pero deja los scripts “bootstrap/seed”)
/db/*.sql
!/db/bootstrap.sql
!/db/seed.sql

# Respaldos generados por scripts/backup_project.php.
# Contienen un dump completo de la base y una copia de storage/attachments:
# jamás deben acabar en el repositorio.
/_backups/

# Paquetes de despliegue generados por scripts/build_release.php.
/_releases/

# IDE/OS
/.vscode/
/.idea/
.DS_Store
Thumbs.db

# Logs / cachés
*.log
/tmp/
